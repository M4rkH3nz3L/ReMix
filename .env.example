# ══════════════════════════════════════════════════════════════════════════
#  ReMix — EGYETLEN env-sablon (minden szükséges változó egy helyen)
#
#  Három FUTÁSI KONTEXTUS van, de MIND itt dokumentált. Másold a megfelelő
#  valós fájlba és töltsd ki (a valós env-ek git-ignoráltak — lásd .gitignore):
#    • APP (Expo kliens)  → .env.development  /  .env.production
#    • SERVER (worker)    → server/.env
#    • SUPABASE functions → supabase/functions/.env   (vagy: supabase secrets set …)
#
#  🔑 Szabályok:
#    • CSAK az EXPO_PUBLIC_* kerül a kliens-bundle-be (publikus!). Titkot SOHA.
#    • A szerver-titkok (SERVICE_ROLE, S3_SECRET, *_SECRET) kizárólag a szerveren.
#    • PROD-ba SOHA loopback (127.0.0.1) címet — a kliens éles buildben elutasítja.
#    • Éles (EAS) buildhez a prod EXPO_PUBLIC_* értékeket inkább EAS env-ként:
#        eas env:set --name EXPO_PUBLIC_SUPABASE_URL --value "https://xxx.supabase.co" \
#                    --environment production --visibility plaintext
# ══════════════════════════════════════════════════════════════════════════


# ═══════════════ 1) APP — Expo kliens  (.env.development / .env.production) ═══
# EXPO_PUBLIC_* → bekerül a bundle-be. DEV: lokális Supabase (supabase status);
# PROD: hosztolt https. Fizikai eszközön a kliens a 127.0.0.1-et a Metró gép
# LAN-IP-jére írja át (src/lib/supabase.ts).
EXPO_PUBLIC_SUPABASE_URL=            # dev: http://127.0.0.1:54421 · prod: https://<projekt>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=       # a supabase status / a hosztolt projekt anon kulcsa

# Felhő-worker (fizetős/AI/felhő-funkciók). PROD-ban KÖTELEZŐ (https), enélkül a
# kiadott app nem éri el a dev-workert.
EXPO_PUBLIC_CLOUD_URL=               # prod: https://render.remix.app

# Dev-worker felülírás (opcionális; alapból a Metró gépéből oldódik fel):
# EXPO_PUBLIC_SERVER_HOST=192.168.0.34                    # hoszt (port marad 8787)
# EXPO_PUBLIC_SERVER_URL=https://valami.trycloudflare.com # teljes cím (tunnel)

# Pro-előfizetés (RevenueCat IAP). Dev-ben üres = IAP kikapcsolt.
EXPO_PUBLIC_RC_IOS_KEY=              # appl_xxx
EXPO_PUBLIC_RC_ANDROID_KEY=          # goog_xxx


# ═══════════════ 2) SERVER — render-worker  (server/.env) ════════════════════
# Az API ÉS a worker is ezt olvassa. [K]=kötelező élesben · a többi opcionális
# (funkció-kapcsoló, értelmes default-tal).

# ── Alap ──
NODE_ENV=production
PORT=8787
RENDER_DOMAIN=                       # [K prod] publikus HTTPS-domain (Caddy/Let's Encrypt), pl. api.pelda.hu
CORS_ORIGINS=                        # [K] böngészős origin-ek vesszővel; natív app nem küld Origin-t

# ── Queue (Redis) — e fölötti hosszú videók a worker-queue-ba kerülnek ──
REDIS_URL=redis://127.0.0.1:6379
RENDER_CONCURRENCY=2
CLOUD_RENDER_MIN_SEC=15

# ── Supabase (szerver-oldali; a worker service_role-lal ír, megkerüli az RLS-t) ──
SUPABASE_URL=                        # [K] pl. https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # [K] TITKOS — soha a kliensre!
SUPABASE_ANON_KEY=                   # [K] a JWT-verifikáláshoz (NEM a service_role erre való)
# A szerver néhány helyen EXPO_PUBLIC_* néven is olvassa — add meg ugyanazt:
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Tárhely: Cloudflare R2 / S3-kompat ('local' csak dev) ──
STORAGE_BACKEND=s3                   # s3 = R2/AWS/MinIO
S3_ENDPOINT=                         # [K] pl. https://<account>.r2.cloudflarestorage.com (dev: http://127.0.0.1:54321/storage/v1/s3)
S3_ACCESS_KEY=                       # [K]  (dev: supabase status → S3 Access Key)
S3_SECRET_KEY=                       # [K]  (dev: supabase status → S3 Secret Key)
S3_BUCKET=remix-media                # dev: renders
S3_REGION=auto                       # R2: auto · dev: local
S3_PUBLIC_STYLE=domain               # R2: a public domain a buckethez kötve
S3_PUBLIC_BASE=                      # [K] a média publikus URL-alapja (R2 custom domain / r2.dev)
MEDIA_PUBLIC_BASE=                   # ugyanaz, a mediastore ezt is nézheti
MEDIA_BUCKET=remix-media             # dev: renders
# MEDIA_LOCAL_DIR=                   # csak STORAGE_BACKEND=local esetén

# ── AI (env-Anthropic; kulcs nélkül lokális Ollama-fallback, ha fut) ──
ANTHROPIC_API_KEY=                   # sk-ant-… · az /ai/* env-útjához + usage-metering
AI_MODEL=claude-sonnet-4-6
# Lokális AI / modellek (opcionális, csak ha nem a default helyen):
# OLLAMA_URL=http://127.0.0.1:11434
# LOCAL_AI_MODEL=qwen3:14b
# LOCAL_VISION_MODEL=qwen2.5vl:7b
# LOCAL_EMBED_MODEL=nomic-embed-text
# LOCAL_BGREMOVE_MODEL=./models/rmbg.onnx
# LOCAL_DEPTH_MODEL=./models/depth.onnx
# LOCAL_FACE_MODEL=./models/face.onnx
# LOCAL_UPSCALE_MODEL=./models/superres.onnx
# AI_EXTRA_HOSTS=ai.sajatdomain.hu          # BYOK SSRF-allowlist bővítés

# ── Külső binárisok (PATH-ból; csak ha máshol vannak) ──
FFMPEG_PATH=ffmpeg
CHROMIUM_PATH=/usr/bin/chromium      # SVG/3D/particle-render (Puppeteer)
# WHISPER_MODEL=./models/ggml-base.bin      # feliratozás (whisper.cpp)
# YTDLP_BIN=/opt/homebrew/bin/yt-dlp        # URL-import (YouTube); alap: PATH

# ── Billing (RevenueCat webhook) ──
RC_WEBHOOK_AUTH=                     # a RevenueCat→worker webhook Authorization-headere

# ── GDPR végleges törlés ──
ALLOW_ACCOUNT_ERASE=1                # a POST /account/erase (hard-erase + R2-purge) engedélyezése

# ── Live (LiveKit) — csak ha élő-közvetítés kell ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_STREAM_KEY_SECRET=

# ── Külső tárhely-OAuth (per-user Drive/Dropbox/OneDrive) — csak ha kell ──
OAUTH_REDIRECT_BASE=                 # a worker PUBLIKUS címe a callbackhez
OAUTH_STATE_SECRET=                  # OAuth-state HMAC titka (alap: SUPABASE_SERVICE_ROLE_KEY)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# ── Kifizetés (PayPal Payouts) — csak ha a cash-out él (store-politika!) ──
PAYPAL_ENV=sandbox                   # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ── Stem-szeparáció (Demucs; külön nehéz Python-image/sidecar) ──
STEMS_ENABLED=0                      # 1 + DEMUCS_BIN, ha telepítve
DEMUCS_BIN=demucs
DEMUCS_MODEL=htdemucs

# ── ⚠️ CSAK LOKÁLIS DEV — prod-ban SOHA (auth-bypass / rate-limit-off!) ──
# ALLOW_INSECURE_DEV=1
# ALLOW_DEV_BILLING=1
# RL_DISABLED=1


# ═══════════════ 3) SUPABASE EDGE FUNCTIONS  (supabase/functions/.env) ═══════
# send-sms → Brevo. NEM kliens-env (nincs EXPO_PUBLIC_ prefix, nem kerül bundle-be).
# Lokál: supabase functions serve send-sms --env-file supabase/functions/.env
# Éles:  supabase secrets set BREVO_API_KEY=… SEND_SMS_HOOK_SECRET='v1,whsec_…' …
BREVO_API_KEY=                       # Brevo → SMTP & API → API keys
SEND_SMS_HOOK_SECRET=                # Supabase Auth → Hooks → Send SMS hook secret (v1,whsec_… EGÉSZBEN)
BREVO_SMS_SENDER=ReMix               # max 11 alfanumerikus karakter
SMS_ALLOWED_DIAL_CODES=36            # engedett országhívószámok vesszővel ('*' = mind — VALÓDI PÉNZ!)
