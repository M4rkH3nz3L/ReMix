# ══════════════════════════════════════════════════════════════════════════
#  ÉLES (PROD) KONFIG — SOHA ne tegyél ide lokális (127.0.0.1) címet!
#
#  Két út a kiadott buildhez (válassz egyet, NE keverd):
#   A) EAS env-változók (AJÁNLOTT) — a build a felhőben ezekből dolgozik:
#        eas env:set --name EXPO_PUBLIC_SUPABASE_URL --value "https://xxx.supabase.co" \
#                    --environment production --visibility plaintext
#      (Az eas.json profiljai az "environment" mezővel hivatkoznak rájuk.)
#   B) Helyi `.env.production` (git-ignorált) — csak LOKÁLIS prod-teszthez
#      (`NODE_ENV=production expo start` / `expo export`). A valós felhő-buildben
#      az EAS env-változók amúgy is felülírják.
#
#  🚫 Keveredés-védelem: éles buildben a kliens ELUTASÍTJA a loopback Supabase-
#     címet (src/lib/supabase.ts) — inkább „nincs konfigurálva" hiba, mint néma
#     összeomlás a bejelentkezésnél.
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase (HOSZTOLT) ───────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<a hosztolt projekt anon kulcsa>

# ── Felhő-worker (HOSZTOLT, fizetős funkciók) ─────────────────────────────
# Enélkül a Pro-funkciók a dev-workerre esnének vissza, ami a kiadott appból
# elérhetetlen. MINDIG https.
EXPO_PUBLIC_CLOUD_URL=https://render.remix.app

# ── Pro-előfizetés (RevenueCat IAP) ───────────────────────────────────────
EXPO_PUBLIC_RC_IOS_KEY=appl_xxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxx

# ⚠️ SERVER_HOST / SERVER_URL CSAK fejlesztéshez — ide (prod) NE kerüljön.
