# dependencies
node_modules/

# lokális teszt-userek (jelszavakat tartalmaz; csak a helyi dev Supabase-ben léteznek)
users.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
server/models/
server/storage.config.json

# env — dev/prod KÜLÖN, hogy ne keveredjenek. A valós env-fájlokat nem verziózzuk,
# csak a *.example sablonokat. (Prod értékek élesben inkább EAS env-változóként.)
.env
.env.development
.env.production
.env.preview

# helyi dev-szolgáltatások logjai/PID-jei (dev-up.sh)
.devlogs/

# editor / eszköz / OS junk (nem kell a repóba)
.vscode/
.claude/
.idea/
.cursor/
.zed/
*.swp
