# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# lokális teszt-userek (jelszavakat tartalmaz; csak a helyi dev Supabase-ben léteznek)
users.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
# natív modulok Gradle build-kimenete (nem verziózzuk)
modules/*/android/build/
server/models/
server/storage.config.json

# env — CSAK a .env.example (gyökér) sablon verziózott; MINDEN valós/lokális env
# ignorált (app + server + supabase functions). Prod értékek élesben inkább EAS
# env-változóként / `supabase secrets set`.
.env
.env.*
!.env.example
server/.env
server/.env.*
supabase/functions/.env
supabase/functions/.env.*
*.xcode.env.local

# helyi dev-szolgáltatások logjai/PID-jei (dev-up.sh)
.devlogs/

# editor / eszköz / OS junk (nem kell a repóba)
.vscode/
.claude/
.idea/
.cursor/
.zed/
*.swp

# futásidejű szerver-artefaktumok (renderelt média, worker-log, render-cache)
server/media/
server/worker.log
server/assets/stickers3d/cache/

# szórvány AI-képek a repó gyökerében
/ChatGPT Image*.png
.livekit-egress-dev/

# worker-env backup (lokál Supabase creds mentése) — SOHA ne kerüljön gitbe
server/.env.bak*

# render-parity smoke kimenetek (dev-eszköz)
.render-smoke/
.imagedoc-smoke/
.audio-smoke/

# devs/ — belső fejlesztői jegyzetek/tervek/taszkok: fejlesztéshez, LOKÁLIS.
# A teljes mappa ignorált (nem kerül a repóba), a fájlok a lemezen maradnak.
devs/
