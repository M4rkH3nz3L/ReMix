# 🔐 ReMix backend — PRODUCTION env SABLON. Másold `.env.production`-ra és töltsd ki.
#   cp .env.production.example .env.production
# A `.env.production` SOHA ne kerüljön a repóba (a .gitignore kizárja). A titkokat
# a szerveren töltsd ki, ne itt. [K]=kötelező · [O]=opcionális (funkció-kapcsoló).

# ── Alap ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8787
# A publikus HTTPS-domain (a Caddy ezt kéri Let's Encryptből; a DNS A-rekord erre a hostra). [K]
RENDER_DOMAIN=api.pelda.hu
# A kliens(ek) origin-je(i) CORS-hoz, vesszővel; mobilnál a séma is lehet. [K]
CORS_ORIGINS=https://pelda.hu,https://app.pelda.hu

# ── Redis (a compose adja; csak akkor írd át, ha külső Redis) ───────────────────
REDIS_URL=redis://redis:6379

# ── Supabase (prod projekt) ─────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co                 # [K]
SUPABASE_SERVICE_ROLE_KEY=                            # [K] SZERVER-oldali, TITKOS (soha kliensre!)
SUPABASE_ANON_KEY=                                    # [K]
# A szerver néhány helyen az EXPO_PUBLIC_* néven is olvassa — add meg ugyanazt:
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co     # [K]
EXPO_PUBLIC_SUPABASE_ANON_KEY=                        # [K]

# ── Tárhely: Cloudflare R2 (S3-kompat) ──────────────────────────────────────────
STORAGE_BACKEND=s3                                    # [K] s3 = R2/AWS/MinIO; 'local' csak dev
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com # [K]
S3_ACCESS_KEY=                                        # [K]
S3_SECRET_KEY=                                        # [K]
S3_BUCKET=remix-media                                 # [K]
S3_REGION=auto                                        # R2: auto
S3_PUBLIC_STYLE=domain                                # R2: a public domain MÁR a buckethez kötve
S3_PUBLIC_BASE=https://media.pelda.hu                 # [K] a média publikus URL-alapja (R2 custom domain / r2.dev)
MEDIA_PUBLIC_BASE=https://media.pelda.hu              # ugyanaz, a mediastore ezt is nézheti
MEDIA_BUCKET=remix-media

# ── AI (env-Anthropic; BYOK/lokál kimarad) ──────────────────────────────────────
ANTHROPIC_API_KEY=                                    # [O] az /ai/* env-útjához + usage-metering
AI_MODEL=claude-sonnet-4-6                            # [O]

# ── Render ──────────────────────────────────────────────────────────────────────
CLOUD_RENDER_MIN_SEC=15                               # e fölött queue→worker (különben in-process az API-n)
RENDER_CONCURRENCY=2                                  # worker-szálak / konténer
FFMPEG_PATH=ffmpeg                                    # a Dockerfile adja
CHROMIUM_PATH=/usr/bin/chromium                       # a Dockerfile adja

# ── Billing / RevenueCat ────────────────────────────────────────────────────────
RC_WEBHOOK_AUTH=                                      # [O] a RevenueCat→worker webhook Authorization-headere

# ── GDPR végleges törlés ────────────────────────────────────────────────────────
ALLOW_ACCOUNT_ERASE=1                                 # a POST /account/erase (hard-erase + R2-purge) engedélyezése

# ── Live (LiveKit) — csak ha élő-közvetítés kell ────────────────────────────────
LIVEKIT_URL=                                          # [O]
LIVEKIT_API_KEY=                                      # [O]
LIVEKIT_API_SECRET=                                   # [O]
LIVE_STREAM_KEY_SECRET=                               # [O]

# ── Külső tárhely-OAuth (Drive/Dropbox/OneDrive) — csak ha kell ─────────────────
OAUTH_REDIRECT_BASE=https://api.pelda.hu              # [O]
OAUTH_STATE_SECRET=                                   # [O]
GOOGLE_OAUTH_CLIENT_ID=                               # [O]
GOOGLE_OAUTH_CLIENT_SECRET=                           # [O]
DROPBOX_APP_KEY=                                      # [O]
DROPBOX_APP_SECRET=                                   # [O]
MS_OAUTH_CLIENT_ID=                                   # [O]
MS_OAUTH_CLIENT_SECRET=                               # [O]

# ── Kifizetés (PayPal Payouts) — csak ha a cash-out él (store-politika!) ────────
PAYPAL_ENV=live                                       # [O] sandbox|live
PAYPAL_CLIENT_ID=                                     # [O]
PAYPAL_SECRET=                                        # [O]

# ── Stem-szeparáció (Demucs) — külön nehéz image/sidecar; alapból KI ────────────
STEMS_ENABLED=0                                       # [O] 1 + DEMUCS_BIN, ha telepítve

# ── ⚠️ BIZTONSÁG: prod-ban EZEK NE legyenek beállítva ───────────────────────────
# ALLOW_INSECURE_DEV=1   ← SOHA prod-ban (auth-bypass!)
# RL_DISABLED=1          ← SOHA prod-ban (rate-limit kikapcsolás)
# ALLOW_DEV_BILLING=1    ← SOHA prod-ban
