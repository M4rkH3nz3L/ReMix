# 📲 Supabase Edge Function secretek (send-sms → Brevo)
#
# ⚠️ Ezek NEM kliens-env-ek: SOHA nem kerülnek a bundle-be, és nincs
# `EXPO_PUBLIC_` prefixük. Két helyen élnek:
#   • LOKÁLIS futtatás: másold `.env`-be, majd
#       supabase functions serve send-sms --env-file supabase/functions/.env
#   • ÉLES: a projekt secretjeibe
#       supabase secrets set BREVO_API_KEY=... SEND_SMS_HOOK_SECRET='v1,whsec_...' \
#         BREVO_SMS_SENDER=ReMix SMS_ALLOWED_DIAL_CODES=36
#
# Beszerzés: Brevo → SMTP & API → API keys & MCP → Generate API key
# (név: `supabase-sms-hook`). A Brevo e-mailben küld egy 6 jegyű ellenőrző kódot.
BREVO_API_KEY=

# A Supabase Auth "Send SMS hook" aláírás-titka (Authentication → Hooks →
# Send SMS hook → Generate secret). `v1,whsec_…` formátum — EGÉSZBEN másold,
# a függvény vágja le a prefixet.
SEND_SMS_HOOK_SECRET=

# SMS feladó-név: legfeljebb 11 ALFANUMERIKUS karakter (Brevo-korlát). Néhány
# országban (pl. USA) a név nem jelenik meg, ott számot mutat a készülék.
BREVO_SMS_SENDER=ReMix

# 🛡️ SMS-pumping védelem: engedélyezett országhívószámok, vesszővel.
# Az SMS előre fizetett kreditből megy = VALÓDI PÉNZ, a bot-regisztrációk
# elégetnék. Üres vagy `*` = minden ország (csak tudatosan!).
SMS_ALLOWED_DIAL_CODES=36
